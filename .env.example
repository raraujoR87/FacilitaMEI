# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Leitura das notas por IA
# Qual provedor tenta primeiro: "claude" (padrão) ou "gemini".
# O outro entra como reserva automática se também estiver configurado.
IA_PROVEDOR=claude

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional: sobrescreve o modelo (padrão claude-opus-5)
CLAUDE_MODELO=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: sobrescreve o modelo (padrão gemini-2.5-flash)
GEMINI_MODELO=

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
