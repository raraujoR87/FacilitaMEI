# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Leitura das notas por IA
# Qual provedor tenta primeiro: "claude" (padrão) ou "gemini".
# O outro entra como reserva automática se também estiver configurado.
IA_PROVEDOR=claude

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional: sobrescreve o modelo (padrão claude-opus-5)
CLAUDE_MODELO=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: sobrescreve o modelo (padrão gemini-2.5-flash)
GEMINI_MODELO=

# Contratação do plano Pro
# Link estático de assinatura do gateway (Asaas, Mercado Pago, Stripe...).
# Todos oferecem link de pagamento, o que dispensa integração de API para
# começar a vender. Sem eles, a tela de planos cai no contato por WhatsApp.
NEXT_PUBLIC_LINK_ASSINATURA_MENSAL=
NEXT_PUBLIC_LINK_ASSINATURA_ANUAL=
# Número de contato comercial, com DDD (ex: 11999998888)
NEXT_PUBLIC_WHATSAPP_CONTATO=

# Contato do controlador de dados, exibido na política de privacidade.
# Exigido pela LGPD: sem ele, a página diz que não foi configurado.
NEXT_PUBLIC_EMAIL_CONTATO=

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
